# ─── Real data — NEVER commit rider data, databases, dumps or backups ────────
# Rules are by directory and extension so a new dump/backup name is covered
# without editing this file. Anonymised samples live in data/sample/ only.
data/
!data/sample/
!data/sample/**
backups/
*.db
*.db-wal
*.db-shm
*.sql
*.sqlite
*.sqlite3
*.zip
*.7z
*.bak
*.bak_*
*.backup
*.pre_paise_backup
*codex_before_paise*
*.recovered*
*.xlsx
!data/sample/*.xlsx
*.xls
*.csv
*.docx
*.pdf

# Scripts / notes that embed real rider data
scripts/build_seed.py
scripts/oneoff/
*recovery*
*Recovery*
fix_meters.*

