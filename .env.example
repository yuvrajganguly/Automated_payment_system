# Copy this file to .env and set a strong secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it stable, or every login token is invalidated on restart.
# Must be at least 32 characters. The app refuses to start otherwise — for a
# throwaway local run without a secret, set PAYOUT_ALLOW_DEV_SECRET=1 instead.
PAYOUT_JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars

# Demo accounts (admin@demo.com / Demo-1234) are created ONLY when this is 1.
# Leave it unset on any deployment that holds real data.
# PAYOUT_SEED_DEMO=0

# Password-reset emails. Without SMTP the "forgot password" flow is disabled
# (an admin resets passwords with `payout-admin reset-password`).
# PAYOUT_SMTP_HOST=smtp.gmail.com
# PAYOUT_SMTP_PORT=587
# PAYOUT_SMTP_USER=you@example.com
# PAYOUT_SMTP_PASS=app-password
# PAYOUT_SMTP_FROM=you@example.com

# Postgres password (local Docker db service). Any value; keep it stable.
POSTGRES_PASSWORD=payout

# Rider documents (KYC uploads from the recruiter app). Default: local disk
# at data/documents (PAYOUT_DOCS_DIR overrides). Set the S3 values to use an
# S3-compatible bucket instead (needs `pip install .[docs]`).
# PAYOUT_DOCS_DIR=data/documents
# PAYOUT_DOCS_MAX_MB=15
# PAYOUT_DOCS_S3_BUCKET=
# PAYOUT_DOCS_S3_ENDPOINT=
# PAYOUT_DOCS_S3_KEY=
# PAYOUT_DOCS_S3_SECRET=
