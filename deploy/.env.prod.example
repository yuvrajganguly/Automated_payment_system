# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public address Caddy serves (auto-HTTPS). Must resolve to this server.
SITE_ADDRESS=payout.qwikserve.in

# openssl rand -hex 24
POSTGRES_PASSWORD=

# openssl rand -hex 32  (>= 32 chars; changing it logs everyone out)
PAYOUT_JWT_SECRET=

# Nightly dump + documents tarball retention (days).
BACKUP_KEEP_DAYS=14

# Password-reset e-mail. Leave unset to disable "forgot password".
# PAYOUT_SMTP_HOST=smtp.gmail.com
# PAYOUT_SMTP_PORT=587
# PAYOUT_SMTP_USER=you@example.com
# PAYOUT_SMTP_PASS=app-password
# PAYOUT_SMTP_FROM=you@example.com

# Rider documents (KYC uploads). Default: the payout_docs Docker volume,
# tarred nightly into deploy/backups/. To keep them in an S3-compatible
# bucket instead (Cloudflare R2 — free tier: 10 GB, no egress fees — or AWS
# S3), set all four; the volume is then unused. For R2 the endpoint is
# https://<account-id>.r2.cloudflarestorage.com and the key/secret come from
# an R2 API token with Object Read & Write on the bucket.
# PAYOUT_DOCS_S3_BUCKET=qwikserve-rider-docs
# PAYOUT_DOCS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PAYOUT_DOCS_S3_KEY=
# PAYOUT_DOCS_S3_SECRET=

# The Android recruiter app calls the API from outside the site origin.
# Comma-separated origins; leave empty until the app exists.
# PAYOUT_CORS_ORIGINS=
